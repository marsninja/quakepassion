+# Whitespace is Unicode's Python-compatible whitespace set, matched as UTF-8.
+# Cursor is a byte boundary: before the next byte for split, after it for rsplit.
+impl NaIRGenPass._emit_whitespace_width(
+    text: ir.Value, cursor: ir.Value, length: ir.Value, reverse: bool
+) -> ir.Value {
+    i8 = ir.IntType(8); i64 = ir.IntType(64);
+    result = self._entry_alloca(i64, "space.width");
+    self.builder.store(ir.Constant(i64, 0), result);
+    byte_index = self.builder.sub(cursor, ir.Constant(i64, 1)) if reverse else cursor;
+    byte = self.builder.load(self.builder.gep(text, [byte_index]));
+    ascii_space = self.builder.or_(
+        self.builder.and_(self.builder.icmp_unsigned(">=", byte, ir.Constant(i8, 9)), self.builder.icmp_unsigned("<=", byte, ir.Constant(i8, 13))),
+        self.builder.and_(self.builder.icmp_unsigned(">=", byte, ir.Constant(i8, 28)), self.builder.icmp_unsigned("<=", byte, ir.Constant(i8, 32)))
+    );
+    self.builder.store(self.builder.select(ascii_space, ir.Constant(i64, 1), ir.Constant(i64, 0)), result);
+    # U+0085, U+00A0, U+1680, U+2000..200A, U+2028/29/2F, U+205F, U+3000.
+    codes = [133, 160, 5760] + list(range(8192, 8203)) + [8232, 8233, 8239, 8287, 12288];
+    for cp in codes {
+        encoded = chr(cp).encode("utf-8");
+        width = len(encoded);
+        func = self.builder.function;
+        check = func.append_basic_block("space.utf8");
+        next = func.append_basic_block("space.next");
+        available = cursor if reverse else self.builder.sub(length, cursor);
+        self.builder.cbranch(self.builder.icmp_unsigned(">=", available, ir.Constant(i64, width)), check, next);
+        self.builder.position_at_end(check);
+        start = self.builder.sub(cursor, ir.Constant(i64, width)) if reverse else cursor;
+        matches: ir.Value = ir.Constant(ir.IntType(1), 1);
+        for offset in range(width) {
+            part = self.builder.load(self.builder.gep(text, [self.builder.add(start, ir.Constant(i64, offset))]));
+            matches = self.builder.and_(matches, self.builder.icmp_unsigned("==", part, ir.Constant(i8, encoded[offset])));
+        }
+        self.builder.store(self.builder.select(matches, ir.Constant(i64, width), self.builder.load(result)), result);
+        self.builder.branch(next);
+        self.builder.position_at_end(next);
+    }
+    return self.builder.load(result);
+}
