#!/usr/bin/env bash
# Drive a running studio from outside (editor/tools/control.jac): each call
# hands it a request of console commands, which it runs in sight, and prints
# the answer it writes as JSON once the last of them has run.
#
#   scripts/qpctl start [qp arguments...]   start ./qp in the studio, taking requests
#   scripts/qpctl 'ed_box_at 0 0 0 64 64 64' 'ed_query made'
#   scripts/qpctl < commands.cfg            one console line a line
#   scripts/qpctl -n ...                    hand it over and do not wait
#   scripts/qpctl -t 300 ...                wait up to so many seconds (120)
#   scripts/qpctl stop                      quit the studio
#
# The folder is QP_CONTROL, else $TMPDIR/qp-control. A studio already open
# takes requests after `ed_control listen <folder>`. The answer's "ok" is
# false when a command was unknown or refused; qpctl then exits 1.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FOLDER="${QP_CONTROL:-${TMPDIR:-/tmp}/qp-control}"
FOLDER="${FOLDER%/}"
WAIT=1
TIMEOUT=120

studio_alive() {
  local pid
  pid="$(cat "$FOLDER/studio.pid" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

send() {
  mkdir -p "$FOLDER/in" "$FOLDER/out"
  local seq
  seq="$(perl -MTime::HiRes=time -e 'printf "%017.0f", time() * 1000000')-$$"
  cat > "$FOLDER/in/.$seq.part"
  mv "$FOLDER/in/.$seq.part" "$FOLDER/in/$seq.cmd"
  if [[ "$WAIT" == 0 ]]; then
    echo "{\"seq\":\"$seq\",\"queued\":true}"
    return 0
  fi
  local answer="$FOLDER/out/$seq.json"
  local deadline=$((SECONDS + TIMEOUT))
  while [[ ! -f "$answer" ]]; do
    if ((SECONDS >= deadline)); then
      echo "qpctl: no answer to $seq after ${TIMEOUT}s (is a studio taking requests from $FOLDER?)" >&2
      return 2
    fi
    sleep 0.05
  done
  cat "$answer"
  local ok=0
  grep -q '"ok":true' "$answer" || ok=1
  rm -f "$answer"
  return "$ok"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) WAIT=0; shift ;;
    -t) TIMEOUT="$2"; shift 2 ;;
    -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
    *) break ;;
  esac
done

case "${1:-}" in
  start)
    shift
    if studio_alive; then
      echo "qpctl: a studio (pid $(cat "$FOLDER/studio.pid")) already takes requests from $FOLDER" >&2
      exit 1
    fi
    mkdir -p "$FOLDER/in" "$FOLDER/out"
    rm -f "$FOLDER"/in/*.cmd "$FOLDER"/out/*.json
    (cd "$REPO_ROOT" && QP_CONTROL="$FOLDER" nohup ./qp +edit +ed_log panel on 8 "$@" > "$FOLDER/qp.log" 2>&1 &)
    # Answered once the studio is open and looking at the folder.
    TIMEOUT=180
    printf 'ed_note Taking requests from %s\n' "$FOLDER" | send
    ;;
  stop)
    WAIT=0
    printf 'quit\n' | send > /dev/null
    echo "{\"stopped\":true}"
    ;;
  "")
    send
    ;;
  *)
    printf '%s\n' "$@" | send
    ;;
esac
