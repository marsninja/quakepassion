"""The bake: everything generated for a content pack, made and written into
the archive the engine lays over the pack (engine/assets/generated.jac).

A bake reads the pack's manifest, fills every slot it has a recipe for, and
writes the archive with a stamp beside it: the generator's version and the
size and time of every archive the manifest was read from. While the stamp
matches, the archive is kept; when either changes, it is made again.

What is made, by kind, is counted: slots filled, and slots left to the
game's own data (a name no recipe covers yet, or one never generated by
design, such as a map's geometry or a script's text)."""
import os;
import time;
import from engine.assets.content { playing, pack_path, assets_root, archive_paths, search_folders }
import from engine.assets.generated {
    generated_folder, generated_archive_name, miptex_path, generated_root
}
import from editor.formats.archive { write_pak, write_zip }
import from .manifest { Manifest, AssetSlot, build_manifest, slots_of }
import from .palette { Palette, quake_palette, quake2_palette, quake_colormap }
import from .image { Picture, Rgb, graded, glowed }
import from .tones { family_tone, GLOW_TONES, SKIN_TONES }
import from .textures { paint_named, paint_role, texture_family, Paint }
import from .writers { ArchiveWriter, miptex_bytes, wav_bytes, wal_bytes, pcx_bytes, tga_bytes, qpic_bytes, wad2_bytes, indexed }
import from .art2d { picture_2d }
import from .models { model_doc, model_family, material_atlas, mdl_bytes, MATERIALS, release_doc }
import from .characters { character_doc, player_part_doc, animation_ranges }
import from .music { make_track }
import from .voices { spoken, spoken_line }
import from .film { film_recipe }
import from .sprites { sprite_picture, spr_bytes, sp2_bytes }
import from .art2d { face }
import from editor.model.document { ModelDoc }
import from editor.model.files { write_md2, write_md3 }
import from .textures { Paint }
import from .skies { sky_side, side_of }
import from .sounds { make_sound }
import from .synth { made_loud }

"""Bumped whenever a recipe changes what it makes, so every bake is made
again."""
glob GENERATOR_VERSION: str = "16";

"""What a bake made, and how it went."""
obj BakeReport {
    has pack: str,
        game: str,
        made: dict[str, int] = {},
        left: dict[str, int] = {},
        files: int = 0,
        seconds: float = 0.0,
        baked: bool = False;

    def words -> str {
        made_words = " ".join([kind + "=" + str(self.made[kind]) for kind in sorted(self.made.keys())]);
        left_words = " ".join([kind + "=" + str(self.left[kind]) for kind in sorted(self.left.keys())]);
        return (
            self.pack + " (" + self.game + "): " + str(self.files) + " files in " + str(round(self.seconds, 1))
                + " s; made " + made_words + "; left " + left_words
        );
    }
}

"""What every recipe of a bake shares: the game, its palette."""
obj BakeContext {
    has game: str,
        palette: Palette,
        # The skins (by name, lower case, without an extension) of the models
        # the bake makes: painted as the material atlas.
        atlas: set[str] = set(),
        # Every slot by its name (lower case): a model's siblings.
        slots: dict[str, AssetSlot] = {},
        # Model families left to the game's own (QP_GENERATED_SKIP, for
        # finding which generated asset a fault follows).
        left_out: list[str] = [];
}

"""A name without its extension, lower case: how skins are matched."""
def stem_of(name: str) -> str {
    lower = name.lower();
    cut = lower.rfind(".");
    slash = lower.rfind("/");
    return lower[:cut] if cut > slash else lower;
}

"""The skins of the models a bake makes (those not left to the game: its
characters until they are made too)."""
def atlas_skins(manifest: Manifest) -> set[str] {
    found: set[str] = set();
    for slot in slots_of(manifest) {
        facts = slot.model;
        if facts is None {
            continue;
        }
        for skins in facts.surface_skins {
            for skin in skins {
                images = manifest.shader_images.get(stem_of(skin), []) + manifest.shader_images.get(skin.lower(), []);
                if not images {
                    images = [skin];
                }
                for image in images {
                    found.add(stem_of(image));
                }
            }
        }
    }
    # Players' skins are named by their .skin files, not their models.
    for slot in slots_of(manifest) {
        lower = slot.name.lower();
        if lower.startswith("models/players/") and slot.kind in ["image", "pcx"] {
            leaf = lower.split("/")[-1];
            if not leaf.startswith("icon_") and not stem_of(leaf).endswith("_i") {
                found.add(stem_of(lower));
            }
        }
    }
    return found;
}

"""A Quake III player's part, made with its siblings' facts: the legs' box
and the animation.cfg beside them."""
def player_doc(context: BakeContext, slot: AssetSlot) -> ModelDoc | None {
    facts = slot.model;
    if facts is None {
        return None;
    }
    folder = slot.name.lower().rsplit("/", 1)[0];
    leaf = slot.name.lower().rsplit("/", 1)[1];
    part = "lower" if leaf.startswith("lower") else ("upper" if leaf.startswith("upper") else "head");
    legs = context.slots.get("md3:" + folder + "/lower.md3");
    config = context.slots.get("text:" + folder + "/animation.cfg");
    legs_facts = legs.model if legs is not None else None;
    if legs_facts is None {
        return None;
    }
    ranges = animation_ranges(config.notes.get("text", "")) if config is not None else [];
    return player_part_doc(slot.name, part, facts, ranges, legs_facts.first_low, legs_facts.first_high);
}

"""A model's skin: the material atlas, toned as the game's own are."""
def skin_atlas(name: str, w: int, h: int, game: str) -> Picture {
    # A creature's or a weapon's is toned toward the painted parts of the
    # game's own (a pickup keeps its colours: the games colour them by kind).
    atlas = material_atlas(name, w, h, game);
    family = model_family(name);
    kind = "weapon" if family == "weapon" else ("character" if family == "character" else "");
    if not kind {
        return atlas;
    }
    return graded(atlas, SKIN_TONES.get(game, {}).get(kind, []), 0.75);
}

"""A wall picture graded to the tone of its family in the game's own."""
def toned(paint: Paint, game: str, family: str) -> Paint {
    tone = family_tone(game, family);
    if not tone {
        return paint;
    }
    return Paint(picture=graded(paint.picture, tone, 1.0), glow=paint.glow);
}

"""The material atlas as palette numbers: its glowing tiles drawn in
Quake's fullbright colours."""
def atlas_indices(name: str, w: int, h: int, context: BakeContext) -> bytes {
    picture = skin_atlas(name, w, h, context.game);
    glow: list[float] = [];
    if context.game == "q1" {
        glow = [0.0] * (w * h);
        for y in range(h) {
            for x in range(w) {
                tile = (y * 4 // h) * 4 + (x * 4 // w);
                if MATERIALS[tile] == "glow" or MATERIALS[tile] == "glowblue" {
                    glow[y * w + x] = 1.0;
                }
            }
        }
    }
    return context.palette.indices(picture, glow, 255);
}

"""The files a slot is filled with; none when no recipe covers it."""
def fill(context: BakeContext, slot: AssetSlot) -> list[tuple[str, bytes]] {
    made: list[tuple[str, bytes]] = [];
    facts = slot.model;
    if facts is not None and slot.kind in ["mdl", "md2", "md3"] {
        if model_family(slot.name) in context.left_out {
            return made;
        }
        doc: ModelDoc | None = None;
        if model_family(slot.name) == "character" {
            if slot.kind == "md3" and slot.name.lower().startswith("models/players/") {
                doc = player_doc(context, slot);
            } elif slot.kind != "md3" {
                doc = character_doc(slot.name, facts, facts.first_low, facts.first_high);
            }
        } else {
            doc = model_doc(slot.name, facts);
        }
        if doc is None {
            return made;
        }
        data = b"";
        if slot.kind == "mdl" {
            count = 0;
            for (first, number, intervals) in facts.skin_groups {
                count = max(count, first + number);
            }
            skins = [atlas_indices(slot.name + "#" + str(k), facts.skin_w, facts.skin_h, context) for k in range(max(1, count))];
            data = mdl_bytes(doc, facts, skins);
        } elif slot.kind == "md2" {
            data = write_md2(doc, facts.skin_w, facts.skin_h);
        } else {
            data = write_md3(doc);
        }
        release_doc(doc);
        if data {
            made.append((slot.name, data));
        }
        return made;
    }
    if stem_of(slot.name) in context.atlas and slot.kind in ["pcx", "image"] {
        w = int(slot.fact("width", 0.0));
        h = int(slot.fact("height", 0.0));
        if w > 0 and h > 0 and slot.notes.get("role", "base") == "base" {
            if slot.kind == "pcx" {
                made.append((slot.name, pcx_bytes(atlas_indices(slot.name, w, h, context), w, h, context.palette)));
            } else {
                made.append((slot.name, tga_bytes(skin_atlas(slot.name, w, h, context.game), False)));
            }
            return made;
        }
    }
    if slot.kind == "spr" and slot.notes.get("frames", "") {
        frames: list[tuple[int, int, int, int, bytes]] = [];
        listed = slot.notes["frames"].split(";");
        for k in range(len(listed)) {
            sizes = [int(word) for word in listed[k].split(",")];
            picture = sprite_picture(slot.name, sizes[0], sizes[1], float(k) / float(max(1, len(listed) - 1)));
            frames.append((sizes[0], sizes[1], sizes[2], sizes[3], indexed(picture, context.palette, 255)));
        }
        made.append((slot.name, spr_bytes(bytes.fromhex(slot.notes["header"]), frames)));
        return made;
    }
    if slot.kind == "sp2" and slot.notes.get("frames", "") {
        sp2_frames: list[tuple[int, int, int, int, str]] = [];
        for entry_text in slot.notes["frames"].split(";") {
            fields = entry_text.split(",");
            sp2_frames.append((int(fields[0]), int(fields[1]), int(fields[2]), int(fields[3]), ",".join(fields[4:])));
        }
        made.append((slot.name, sp2_bytes(sp2_frames)));
        return made;
    }
    if slot.kind == "pcx" and slot.name.lower().startswith("sprites/") {
        w = int(slot.fact("width", 0.0));
        h = int(slot.fact("height", 0.0));
        if w > 0 and h > 0 {
            stem = stem_of(slot.name).split("/")[-1];
            number = stem.rsplit("_", 1)[-1] if "_" in stem else "0";
            phase = min(1.0, float(int(number)) / 8.0) if number.isdigit() else 0.0;
            made.append((slot.name, pcx_bytes(indexed(sprite_picture(slot.name, w, h, phase), context.palette, 255), w, h, context.palette)));
        }
        return made;
    }
    if slot.kind == "film" {
        made.append((slot.name, film_recipe(slot.name, slot.fact("seconds", 8.0))));
        return made;
    }
    if slot.kind == "music" {
        if "music" in context.left_out {
            return made;
        }
        seconds = min(150.0, max(30.0, slot.fact("seconds", 120.0)));
        track = make_track(slot.name, context.game, seconds);
        made.append((slot.name, wav_bytes(track.samples, track.rate, 16, -1)));
        return made;
    }
    lower_name = slot.name.lower();
    if lower_name.startswith("models/players/") and slot.kind in ["image", "pcx"] {
        leaf_name = lower_name.split("/")[-1];
        if leaf_name.startswith("icon_") or stem_of(leaf_name).endswith("_i") {
            w = int(slot.fact("width", 0.0));
            h = int(slot.fact("height", 0.0));
            if w > 0 and h > 0 {
                pictured = face(lower_name, w, h);
                if slot.kind == "pcx" {
                    made.append((slot.name, pcx_bytes(indexed(pictured, context.palette, 255), w, h, context.palette)));
                } else {
                    made.append((slot.name, tga_bytes(pictured, True)));
                }
            }
            return made;
        }
    }
    if slot.kind == "sound" and slot.name.lower().endswith(".wav") {
        rate = int(slot.fact("rate", 11025.0 if context.game == "q1" else 22050.0));
        if rate < 8000 or rate > 48000 {
            rate = 22050;
        }
        loops = slot.fact("loop", -1.0) >= 0.0;
        wave = make_sound(slot.name, slot.fact("seconds", 0.5), rate, loops, context.game, slot.fact("loudness", 0.0));
        if spoken(slot.name) {
            wave = spoken_line(slot.name, slot.fact("seconds", 0.8), rate);
            if slot.fact("loudness", 0.0) > 0.0 {
                wave = made_loud(wave, slot.fact("loudness", 0.0));
            }
        }
        bits = 8 if slot.fact("width", 2.0) < 1.5 else 16;
        made.append((slot.name, wav_bytes(wave.samples, wave.rate, bits, 0 if loops else -1)));
        return made;
    }
    if slot.name.lower().startswith("env/") and slot.kind in ["image", "pcx"] {
        side = side_of(slot.name);
        size = int(slot.fact("width", 256.0));
        if side >= 0 and size > 0 {
            stem = slot.name.lower()[4:].rsplit(".", 1)[0][:-2];
            picture = sky_side(stem, side, size);
            if slot.kind == "pcx" {
                made.append((slot.name, pcx_bytes(context.palette.indices(picture), size, size, context.palette)));
            } else {
                made.append((slot.name, tga_bytes(picture, False)));
            }
        }
        return made;
    }
    if context.game == "q3" {
        if slot.kind == "image" {
            w = int(slot.fact("width", 0.0));
            h = int(slot.fact("height", 0.0));
            lower = slot.name.lower();
            role = slot.notes.get("role", "base");
            if w <= 0 or h <= 0 {
                return made;
            }
            # Quake III's texture coordinates do not depend on an image's
            # size, so a very large one is made smaller.
            if w > 1024 or h > 1024 {
                shrink = 1024.0 / float(max(w, h));
                w = max(8, int(float(w) * shrink));
                h = max(8, int(float(h) * shrink));
            }
            if lower.startswith("models/") and role == "base" and "weaphits" not in lower {
                # Every model is generated, so every model skin is the atlas.
                made.append((slot.name, tga_bytes(skin_atlas(slot.name, w, h, "q3"), False)));
                return made;
            }
            if lower.startswith("sprites/") or "weaphits" in lower {
                painted_glow = paint_role(slot.name, w, h, "add" if role == "base" else role);
                if role in ["base", "add"] {
                    painted_glow = Paint(picture=glowed(painted_glow.picture, GLOW_TONES["effect"][0], GLOW_TONES["effect"][1]));
                }
                made.append((slot.name, tga_bytes(painted_glow.picture, role in ["blend", "alpha"])));
                return made;
            }
            # The 2D art is drawn as 2D art whatever its shader does with
            # it (the console font and the status numbers are blended).
            two_d = lower.startswith("gfx/2d/") or lower.startswith("menu/") or lower.startswith("icons/")
                or lower.startswith("ui/") or lower.startswith("levelshots/") or lower.startswith("gfx/damage/");
            if two_d {
                drawn_2d = picture_2d(slot.name, w, h, "q3");
                if drawn_2d is not None {
                    made.append((slot.name, tga_bytes(drawn_2d, True)));
                    return made;
                }
            }
            if lower.startswith("textures/") or lower.startswith("models/") or role != "base" {
                painted = paint_role(slot.name, w, h, role);
                if lower.startswith("textures/") and role in ["base", "blend", "unblend", "alpha"] {
                    painted = toned(painted, "q3", texture_family(slot.name, "q3"));
                } elif role == "add" {
                    which = "wall" if lower.startswith("textures/") else "effect";
                    painted = Paint(picture=glowed(painted.picture, GLOW_TONES[which][0], GLOW_TONES[which][1]));
                }
                made.append((slot.name, tga_bytes(painted.picture, role in ["alpha", "blend", "unblend"])));
                return made;
            }
            drawn = picture_2d(slot.name, w, h, "q3");
            if drawn is not None {
                made.append((slot.name, tga_bytes(drawn, True)));
            }
        }
        return made;
    }
    if context.game == "q2" {
        if slot.kind == "wal" {
            w = int(slot.fact("width", 64.0));
            h = int(slot.fact("height", 64.0));
            flags = int(slot.fact("flags", 0.0));
            contents = int(slot.fact("contents", 0.0));
            hint = "";
            if flags & 4 {
                hint = "sky";
            } elif flags & 8 {
                hint = "lava" if contents & 8 else ("slime" if contents & 16 else "water");
            } elif flags & 1 {
                hint = "light";
            } elif flags & 48 {
                hint = "glass";
            }
            leaf = slot.name[9:] if slot.name.lower().startswith("textures/") else slot.name;
            leaf = leaf[:-4] if leaf.lower().endswith(".wal") else leaf;
            painted = toned(paint_named(leaf, w, h, "q2", hint), "q2", hint if hint else texture_family(slot.name, "q2"));
            data = wal_bytes(
                leaf, painted, context.palette, slot.notes.get("next", ""), flags, contents,
                int(slot.fact("value", 0.0))
            );
            if data {
                made.append((slot.name, data));
            }
        } elif slot.kind == "pcx" and slot.name.lower().startswith("pics/") and slot.name.lower() != "pics/colormap.pcx" {
            w = int(slot.fact("width", 0.0));
            h = int(slot.fact("height", 0.0));
            drawn = picture_2d(slot.name, w, h, "q2");
            if drawn is not None {
                made.append((slot.name, pcx_bytes(indexed(drawn, context.palette, 255), w, h, context.palette)));
            }
        } elif slot.name.lower() == "pics/colormap.pcx" {
            # The colours at 64 levels of light, as the file keeps them; the
            # engine reads only the palette after them.
            table = bytearray();
            for level in range(64) {
                k = 2.0 - float(level) / 32.0;
                for i in range(256) {
                    table.append(context.palette.index_of(context.palette.colours[i].scaled(k)));
                }
            }
            made.append((slot.name, pcx_bytes(bytes(table), 256, 64, context.palette)));
        }
        return made;
    }
    if context.game == "q1" {
        if slot.kind == "miptex" {
            w = int(slot.fact("width", 64.0));
            h = int(slot.fact("height", 64.0));
            painted = paint_named(slot.name, w, h, "q1");
            if not slot.name.lower().startswith("sky") and not slot.name.startswith("*") {
                painted = toned(painted, "q1", texture_family(slot.name, "q1"));
            }
            data = miptex_bytes(slot.name, painted, context.palette, slot.name.lower().startswith("sky"));
            if data {
                made.append((miptex_path(slot.name), data));
            }
        } elif slot.kind == "wad" and slot.notes.get("lumps", "") {
            lumps: list[tuple[str, int, bytes]] = [];
            for entry_text in slot.notes["lumps"].split(";") {
                parts = entry_text.split(":");
                if len(parts) != 4 {
                    continue;
                }
                lump = parts[0];
                lump_kind = int(parts[1]);
                w = int(parts[2]);
                h = int(parts[3]);
                if lump == "conchars" {
                    sheet = picture_2d("conchars", 128, 128, "q1");
                    if sheet is not None {
                        lumps.append((lump, lump_kind, indexed(sheet, context.palette, 0, True)));
                    }
                } elif lump_kind == 64 or lump == "palette" {
                    lumps.append((lump, lump_kind, context.palette.bytes768()));
                } elif lump_kind == 66 and w > 0 and h > 0 {
                    drawn = picture_2d(lump, w, h, "q1");
                    if drawn is not None {
                        lumps.append((lump, lump_kind, qpic_bytes(indexed(drawn, context.palette, 255), w, h)));
                    }
                }
            }
            made.append((slot.name, wad2_bytes(lumps)));
        } elif slot.kind == "lmp" and slot.fact("width", 0.0) > 0.0 {
            w = int(slot.fact("width", 0.0));
            h = int(slot.fact("height", 0.0));
            drawn = picture_2d(slot.name, w, h, "q1");
            if drawn is not None {
                made.append((slot.name, qpic_bytes(indexed(drawn, context.palette, 255), w, h)));
            }
        } elif slot.kind == "lmp" and slot.name.lower() == "gfx/palette.lmp" {
            made.append((slot.name, context.palette.bytes768()));
        } elif slot.kind == "lmp" and slot.name.lower() == "gfx/colormap.lmp" {
            made.append((slot.name, quake_colormap(context.palette)));
        }
    }
    return made;
}

"""The stamp of a search path: the generator's version and each archive's
name, size and time."""
def stamp_of(path: str, game: str) -> str {
    lines = ["generator " + GENERATOR_VERSION, "game " + game];
    for archive in archive_paths(path, ".pk3" if game == "q3" else ".pak") {
        try {
            lines.append(archive + " " + str(os.path.getsize(archive)) + " " + str(int(os.path.getmtime(archive))));
        } except OSError {
            lines.append(archive + " missing");
        }
    }
    return "\n".join(lines) + "\n";
}

def:priv read_text(path: str) -> str {
    try {
        with open(path, "r") as handle {
            return handle.read();
        }
    } except OSError {
        return "";
    }
}

"""Bake a pack: its manifest read from `path`, every slot filled that can
be, the archive and its stamp written into the pack's generated folder."""
def bake_pack(game: str, pack: str, path: str) -> BakeReport {
    began = time.time();
    record = BakeReport(pack=pack, game=game);
    manifest = build_manifest(game, pack, path);
    palette = quake2_palette() if game == "q2" else quake_palette();
    context = BakeContext(game=game, palette=palette, atlas=atlas_skins(manifest), left_out=os.getenv("QP_GENERATED_SKIP", "").split(","));
    for slot in slots_of(manifest) {
        context.slots[slot.kind + ":" + slot.name.lower()] = slot;
    }
    folder = generated_folder(pack);
    os.makedirs(folder, exist_ok=True);
    target = folder + "/" + generated_archive_name(game);
    staged = target + ".part";
    archive = ArchiveWriter(path=staged, zip=game == "q3");
    archive.begin();
    for slot in slots_of(manifest) {
        filled = fill(context, slot);
        if filled {
            record.made[slot.kind] = record.made.get(slot.kind, 0) + 1;
        } else {
            record.left[slot.kind] = record.left.get(slot.kind, 0) + 1;
        }
        for (name, data) in filled {
            archive.add(name, data);
        }
    }
    archive.finish();
    os.replace(staged, target);
    with open(folder + "/stamp.txt", "w") as handle {
        handle.write(stamp_of(path, game));
    }
    record.files = archive.count;
    record.seconds = time.time() - began;
    record.baked = True;
    return record;
}

"""The packs a game draws on, with their search paths: the pack it is
playing, or for Passion the three games' base folders."""
def packs_of(game: str) -> list[tuple[str, str, str]] {
    if game == "passion" {
        base = assets_root();
        found: list[tuple[str, str, str]] = [];
        for (id, folder) in [("q1", "id1"), ("q2", "baseq2"), ("q3", "baseq3")] {
            if os.path.isdir(base + "/" + folder) {
                found.append((id, id, base + "/" + folder));
            }
        }
        return found;
    }
    pack = playing(game);
    if pack is None {
        return [];
    }
    return [(pack.game, pack.id, pack_path(pack))];
}

"""Bake whatever a game draws on that is missing or out of date; the
records of what was baked (none when everything was current)."""
def ensure_generated(game: str) -> list[BakeReport] {
    records: list[BakeReport] = [];
    for (rules, pack, path) in packs_of(game) {
        folder = generated_folder(pack);
        current = read_text(folder + "/stamp.txt") == stamp_of(path, rules)
            and os.path.exists(folder + "/" + generated_archive_name(rules));
        if not current {
            records.append(bake_pack(rules, pack, path));
        }
    }
    return records;
}
